# Supabase project URL (public, safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (public, safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key (SECRET, server-only, never in browser)
# Find this in Supabase dashboard: Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign the RSVP party_id cookie (SECRET, server-only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RSVP_COOKIE_SECRET=your-random-secret-here
